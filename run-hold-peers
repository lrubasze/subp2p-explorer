#!/bin/bash

# Hold many fake light peers against one node to see how many it accepts.
#
# The node under test gates inbound light peers with --in-peers-light (default
# 100) and inbound full peers with --in-peers (default 32). Raise whichever one
# you are measuring, or the run just stops at the default. That is why the
# default target below is a local node rather than a public one:
#
#   polkadot --dev --in-peers-light 2000 --port 30333 --rpc-port 9944
#
# The node also caps total incoming connections at 10000, compiled in, so that
# is the ceiling for this test.

#URL=ws://127.0.0.1:9944
#ADDRESS=/ip4/127.0.0.1/tcp/30333

URL=wss://kusama-rpc.polkadot.io
ADDRESS=/ip4/195.154.218.123/tcp/30333

#URL=wss://paseo-asset-hub-next-rpc.polkadot.io
#ADDRESS=/dns4/paseo-asset-hub-next-collator-node-0.parity-testnet.parity.io/tcp/443/wss

# Set GENESIS to skip the RPC entirely. Unlike spam-light / soak-light this
# command needs no live chain state, only the genesis hash.
GENESIS=${GENESIS:-}

# light hits --in-peers-light, full and authority hit --in-peers
ROLE=${ROLE:-light}
PEERS=${PEERS:-1000}
DURATION=${DURATION:-120}
# Gap between opening peers. Keep a ramp: with RAMP_MS=0 the node admits the
# whole burst before its slot accounting catches up, which inflates the peak.
# Measured against --in-peers 32: a burst of 50 full peers was all admitted
# (bounded only by in_peers + in_peers_light, the peerset's inbound cap), then
# converged to exactly 32. A ramped run reports 32 for both peak and steady.
# So for a burst run, read steady and ignore peak.
RAMP_MS=${RAMP_MS:-10}
# Our side only. A refused peer is dropped by the node after its own idle
# timeout (measured: 10.0s against a dev node) regardless of this value.
IDLE_TIMEOUT=${IDLE_TIMEOUT:-300}

# Set OUT_DIR to capture one comparable dataset per run, e.g.
#
#   OUT_DIR=results/light-500 PEERS=500 ./run-hold-peers
#
# It collects hold-samples.csv + hold-blocks.csv (written by the CLI), node.csv
# (run-monitor-node, started here and stopped when the run ends), meta.txt (the
# run parameters) and hold.log (this console output). run-monitor-node's HOST /
# INTERVAL variables pass through. Unset, the run behaves as before.
OUT_DIR=${OUT_DIR:-}

export RUST_LOG=info

if [ -n "$GENESIS" ]; then
    CHAIN_SOURCE="--genesis $GENESIS"
else
    CHAIN_SOURCE="--url $URL"
fi

# Build once: cargo build --release -p subp2p-explorer-cli
CMD=(./target/release/subp2p-explorer-cli hold-peers $CHAIN_SOURCE --address $ADDRESS
    --role $ROLE --peers $PEERS --ramp-ms $RAMP_MS --duration $DURATION --idle-timeout $IDLE_TIMEOUT)

if [ -z "$OUT_DIR" ]; then
    exec "${CMD[@]}"
fi

mkdir -p "$OUT_DIR"
{
    echo "date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "address=$ADDRESS"
    echo "role=$ROLE peers=$PEERS duration=$DURATION ramp_ms=$RAMP_MS idle_timeout=$IDLE_TIMEOUT"
} > "$OUT_DIR/meta.txt"

OUT_DIR="$OUT_DIR" ./run-monitor-node &
MONITOR_PID=$!
trap 'kill $MONITOR_PID 2>/dev/null' EXIT

"${CMD[@]}" --out-dir "$OUT_DIR" 2>&1 | tee "$OUT_DIR/hold.log"
