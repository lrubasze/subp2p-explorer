#!/bin/bash

# Reduce a sweep to one row per operation: the numbers the campaign is reporting.
#
#   ./sweep-table results/serving-2026-09-01/sweep/sweep.csv
#
# COLUMNS, and why each is read where it is:
#
#   serve_ms   p50 at ONE client. Past the knee `send->resp` is queueing, not
#              service: the heavy call reads 15.4 ms at 2 clients and 155.2 ms at
#              20 for identical throughput, each extra client adding exactly
#              1/throughput. A serve time taken under load is inflated, and the
#              inflation is invisible in the output.
#   ceiling    the PEAK of the curve, not its last point — past the knee
#              throughput falls again from self-inflicted congestion collapse.
#   knee       smallest client count reaching 97% of the peak: the cheapest
#              concurrency that saturates. It moves with serve time, which is why
#              one client count cannot be reused across operations.
#   par        ceiling x serve_ms = requests in flight at saturation (Little's
#              law). NOT constant across operations, so there is no fixed worker
#              pool; cheap requests interleave better.
#   MB/s       ceiling x proof size — what decides whether a real deployment hits
#              its uplink before it hits the node.
#   shed%      at the ceiling point. Zero shed at the peak means the number is a
#              floor, not a ceiling: the node was never pushed to refuse.
#   cores      CPU seconds of the *polkadot process only*, over the point's wall
#              time — the sampler reads /proc/<polkadot pid>/stat, so the generator
#              is NOT included even though it shares the box. Includes the node's
#              own work (importing Kusama), which idles at ~0.47 cores here.
#              This is the column that refutes the single-serial-worker model:
#              MEASURED 5.89 cores while serving small reads at 25,254/s.
#   cache%     trie node-cache hit rate over the point. Node-wide, so it is only
#              attributable while a single operation runs.
#   uplink%    share of a spec 500 Mbit/s uplink consumed at the node ceiling.
#              Above 100% the node's capacity is unreachable in the field.

set -u

CSV=${1:-}
[ -n "$CSV" ] && [ -f "$CSV" ] || { echo "usage: $0 <sweep.csv>" >&2; exit 1; }

UPLINK_MBIT=${UPLINK_MBIT:-500}

awk -F, -v uplink_mbit="$UPLINK_MBIT" '
function label(m) {
    if (m ~ /^read:.*rand48$/)     return "small read, System::Account[rand]"
    if (m ~ /^read:cec5070d/)      return "mid read, Session::Validators"
    if (m == "warp_code")          return "large read, :code + :heappages"
    if (m == "Core_version")       return "quick call, no storage"
    if (m == "account_nonce")      return "mid call, one account read"
    if (m == "babe_configuration") return "call, large response"
    if (m == "Metadata_metadata")  return "heavy call, 887 B response"
    return substr(m, 1, 34)
}
NR == 1 { next }
{
    op = $1; c = $3 + 0; served = $6 + 0
    if (!(op in seen)) { seen[op] = 1; order[++k] = op }
    if (c == 1) { serve[op] = $14 + 0 }
    if (served > peak[op]) {
        peak[op]  = served
        lbl[op]   = label($2)
        proof[op] = $17 + 0
        pshed[op] = ($8 + $10 > 0 ? 100 * $10 / ($8 + $10) : 0)
        pcpu[op]  = $20 + 0
        pdur[op]  = $4 + 0
        phit[op]  = $23 + 0
        pc[op]    = c
    }
    pts[op, ++np[op]] = c "," served
}
END {
    up_bs = uplink_mbit * 125000
    printf "%-6s %-34s %8s %5s %8s %5s %8s %6s %6s %6s %7s\n", \
        "op", "request", "serve_ms", "knee", "ceiling", "par", "MB/s", "shed%", "cores", "cache%", "uplink%"
    for (i = 1; i <= k; i++) {
        op = order[i]
        knee = pc[op]
        for (j = 1; j <= np[op]; j++) {
            split(pts[op, j], p, ",")
            if (p[2] >= 0.97 * peak[op] && p[1] < knee) knee = p[1]
        }
        printf "%-6s %-34s %8.1f %5d %8d %5.1f %8.1f %6.1f %6.2f %6.1f %7.0f\n", \
            op, lbl[op], serve[op], knee, peak[op], \
            peak[op] * serve[op] / 1000, \
            peak[op] * proof[op] / 1048576, \
            pshed[op], \
            (pdur[op] > 0 ? pcpu[op] / pdur[op] : 0), \
            phit[op], \
            100 * peak[op] * proof[op] / up_bs
    }
    printf "\nuplink%% is against a spec %d Mbit/s node; >100%% means the link binds first.\n", uplink_mbit
}
' "$CSV"
